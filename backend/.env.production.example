# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN PARA RAILWAY
# ============================================

# Aplicación
APP_NAME="SaaS_Citas"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:o1Vh3O1hVdp+Wr46RKiI2Wt33daebbSwWqv/TkGpgcA=
APP_URL=https://back-proyectosas-pagina.up.railway.app
APP_TIMEZONE=America/Bogota

# Base de Datos (Railway MySQL)
DB_CONNECTION=mysql
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_HOST=${{MySQL.RAILWAY_PRIVATE_DOMAIN}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USERNAME=${{MySQL.MYSQLUSER}}

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error
QUEUE_CONNECTION=database

# Session
SESSION_DRIVER=cookie
SESSION_DOMAIN=.railway.app

# CORS
SANCTUM_STATEFUL_DOMAINS=https://saas-citas.vercel.app/

# ============================================
# CORREO ELECTRÓNICO - RESEND
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_CHhtom9R_NQLESLTeNNd77WdAXGgqjPZf
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="Sistema de Citas"

# Resend API Key para SDK directo
RESEND_API_KEY=re_CHhtom9R_NQLESLTeNNd77WdAXGgqjPZf

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. APP_KEY: Genera una nueva con: php artisan key:generate --show
# 2. APP_URL: Railway lo configura automáticamente con ${{RAILWAY_PUBLIC_DOMAIN}}
# 3. DATABASE: Railway configura automáticamente si usas MySQL de Railway
# 4. MAIL_PASSWORD: Es la contraseña de aplicación de Google (16 caracteres)
# 5. Nunca commitees este archivo con credenciales reales

# ============================================
# LÍMITES DE GMAIL
# ============================================
# Gmail permite ~500 correos/día
# Para mayor volumen considera SendGrid, Mailgun o SES

# ============================================
# ALTERNATIVAS DE CORREO PARA PRODUCCIÓN
# ============================================

